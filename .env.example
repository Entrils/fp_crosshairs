NODE_ENV=development
HTTPS_ENABLED=false
PORT=4173

# Минимум 16 и 32 символа соответственно. В production используйте случайные значения.
ADMIN_PASSWORD=change-this-local-admin-password
SESSION_SECRET=change-this-session-secret-at-least-32-characters

DATABASE_URL=postgresql://fragpunk:fragpunk_local_db_password@127.0.0.1:15432/fragpunk
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_PASSWORD=fragpunk_local_db_password
REDIS_URL=redis://127.0.0.1:16379

S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=fragpunk-crosshairs
S3_ACCESS_KEY_ID=fragpunk-local
S3_SECRET_ACCESS_KEY=change-this-local-storage-password
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

PUBLIC_ORIGIN=http://localhost:5173
APP_PUBLIC_ORIGIN=http://localhost:14173
APP_PORT=14173
TRUST_PROXY=0
